        {
          "offset": 1,
          "color": "#4F66FF",
          "at": "outward"
        }
      ]
    },
    "page": {
      "description": "Symbol page body.",
      "stops": [
        {
          "offset": 0,
          "color": "#20294A"
        },
        {
          "offset": 1,
          "color": "#0B1220"
        }
      ]
    },
    "fold": {
      "description": "Folded corner.",
